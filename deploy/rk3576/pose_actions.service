[Unit]
Description=MotionBERT action candidates from YOLO26 skeletons
After=pose_monitor.service
Wants=pose_monitor.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/Develop/pose
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/root/.cache/pose-motionbert/venv/bin/python -u /root/Develop/pose/action_build/live_motionbert.py /root/.cache/pose-motionbert/motionbert-ntu60-32.onnx --threads 2 --interval 15
ExecStopPost=/usr/bin/rm -f /run/pose/actions.json /run/pose/actions.tmp
CPUAffinity=4 5 6 7
CPUQuota=200%
Nice=10
MemoryMax=900M
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=20

[Install]
WantedBy=multi-user.target
